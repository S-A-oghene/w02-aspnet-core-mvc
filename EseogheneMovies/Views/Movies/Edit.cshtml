@model Movie
@{
    ViewData["Title"] = "Edit Movie";
}
<section class="page-heading">
    <p class="eyebrow">UPDATE YOUR COLLECTION</p>
    <h1>Edit movie</h1>
    <p>Change the details below and save your updates.</p>
</section>
<div class="form-panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="All" class="validation-summary"></div>
        <input type="hidden" asp-for="Id" />
        <partial name="_MovieFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="button button-primary">Save changes</button>
            <a asp-action="Index" class="button button-secondary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
