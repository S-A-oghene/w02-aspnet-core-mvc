<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A personal movie collection built with ASP.NET Core MVC." />
    <title>@ViewData["Title"] - Eseoghene Movies</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Movies" asp-action="Index" aria-label="Eseoghene Movies home">
                <span class="brand-mark" aria-hidden="true">EM</span>
                <span>Eseoghene <strong>Movies</strong></span>
            </a>
            <nav class="main-nav" aria-label="Main navigation">
                <a asp-controller="Movies" asp-action="Index">My collection</a>
                <a asp-controller="Movies" asp-action="Create">Add a movie</a>
                <a asp-controller="HelloWorld" asp-action="Index">MVC tutorial</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @if (TempData["SuccessMessage"] is string message)
        {
            <div class="notice notice-success" role="status">@message</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <span>&copy; @DateTime.UtcNow.Year Eseoghene Movies</span>
            <span>Built with ASP.NET Core MVC and Entity Framework Core</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
